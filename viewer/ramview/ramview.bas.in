10 REM TS-PICO SRAM IMAGE VIEWER
20 CLEAR 38911: BORDER 7: PAPER 7: INK 0: CLS
25 PRINT "RAMVIEW: LOADING VIEWER CODE"
30 LOAD "ram-bank" CODE
35 LOAD "ram-core" CODE
40 LOAD "ram-help" CODE
45 PRINT "CODE READY"
50 LET I=0: LET ST=0: ON ERR GO TO 500
60 LET NI=@IMAGE_COUNT@: LET T=10: LET LP=1
62 LET RW=1: LET W=0: LET WS=2: LET DP=1
64 BORDER 5: RANDOMIZE USR 38930: POKE 39821,WS: POKE 39685,DP
66 LET CR=-1: LET ST=0: LET PH=0
80 RESTORE 9500
90 FOR I=1 TO NI
100 BORDER 6: RANDOMIZE USR 39808: POKE 39682,2: RANDOMIZE USR 38933: PAPER 7: INK 0: CLS
110 READ P$: LET EC=0
112 IF LEN P$<5 THEN GO TO 120
114 IF P$( TO 4)="ecm:" OR P$( TO 4)="ECM:" THEN LET EC=1: LET P$=P$(5 TO )
118 LET S$="Mounting tape": GO SUB 800
120 LET ST=1: LET Q$="tpi:"+P$: LOAD Q$
130 POKE 40960,0
135 IF EC<>0 THEN GO TO 400
140 LET ST=2: LET S$="Palette": GO SUB 800: LOAD "ula-pal" CODE 40960,80
150 LET V=USR 39817: IF V<>0 THEN GO TO 500
155 IF PEEK 40966<>0 OR PEEK 40965=7 THEN GO SUB 900
160 LET L=PEEK 40968+256*PEEK 40969
170 LET N=PEEK 40970+256*PEEK 40971
180 LET S$="Screen 1": GO SUB 800: LOAD "ula-df1" CODE 41040,L
190 IF N<>0 THEN LET S$="Screen 2": GO SUB 800: LOAD "ula-df2" CODE 41040+L,N
200 LET ST=3: LET S$="Checking image": GO SUB 800: LET V=USR 38918: IF V<>0 THEN GO TO 500
210 GO SUB 700
220 LET ST=4: LET S$="Writing/checking SRAM": GO SUB 800: LET V=USR 38912: IF V<>0 THEN GO TO 500
225 PRINT AT 2,0;I;"/";NI;"  ";INT (I*100/NI);"% READY   "
230 NEXT I
235 PRINT AT 6,0;"CACHE READY - STARTING PLAYBACK": PAUSE 60
240 LET CR=-1: LET PH=1
250 FOR I=1 TO NI
260 GO SUB 700
270 LET ST=5: LET V=USR 38915: IF V<>0 THEN GO TO 500
280 LET V=USR 38918: IF V<>0 THEN GO TO 500
290 IF RW<>0 THEN POKE 39820,INT (RND*4)+1
292 IF RW=0 THEN POKE 39820,W
294 RANDOMIZE USR 38924
300 LET ST=6: LET V=USR 39811: IF V<>0 THEN GO TO 500
310 RANDOMIZE USR 38927
320 LET FF=PEEK 40965: IF PEEK 40966=1 THEN LET FF=2
330 POKE 39682,FF
340 IF T=0 THEN PAUSE 0
350 IF T<>0 THEN PAUSE T*60
360 NEXT I
370 IF LP<>0 THEN GO TO 250
380 GO TO 500
400 LET ST=2: LET S$="ECM attributes": GO SUB 800: LOAD "ecm-atr" CODE 47184,6144
410 LET S$="ECM pixels": GO SUB 800: LOAD "ecm-pix" CODE 41040,6144
420 LET V=USR 39826: IF V<>0 THEN GO TO 500
430 GO TO 200
500 ON ERR RESET
510 RANDOMIZE USR 39814
520 BORDER 7: PAPER 7: INK 0: FLASH 0: BRIGHT 0: INVERSE 0: OVER 0: CLS
530 PRINT "RAM VIEWER STOPPED"
540 PRINT "IMAGE ";I;" STAGE ";ST
550 STOP
700 LET R=2*INT ((I-1)/3)
710 LET J=I-1-3*INT ((I-1)/3)
720 LET B=0: IF J=1 THEN LET B=16384
730 IF J=2 THEN LET B=40960
740 POKE 39680,B-256*INT (B/256): POKE 39681,INT (B/256)
750 IF R=CR THEN RETURN
760 RANDOMIZE USR 39808: POKE 39682,2: POKE 39684,0
765 IF PH=0 THEN RANDOMIZE USR 38933: PAPER 7: INK 0: CLS: LET S$="Selecting SRAM": GO SUB 800
770 SAVE "tpi:memdock" CODE 1,R
780 RANDOMIZE USR 38921
790 LET CR=R: RETURN
800 PRINT AT 0,0;"RAMVIEW - PRELOADING"
810 PRINT AT 2,0;I;"/";NI;"  ";INT ((I-1)*100/NI);"%   "
820 PRINT AT 4,0;P$;"            "
830 PRINT AT 6,0;S$;"                    "
850 RETURN
@HARDWARE_CHECK@
9500 REM IMAGE LIST: ECM: PREFIX FOR OLD ECM TAP FILES
@IMAGE_DATA@
