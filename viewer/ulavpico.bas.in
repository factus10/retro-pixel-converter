10 REM ULAVIEW TS-PICO SLIDESHOW
20 CLEAR 39935: BORDER 0: PAPER 0: INK 7: CLS
30 RESTORE 9000
40 LET A=39936
42 READ C$
43 FOR I=1 TO LEN C$ STEP 2
44 LET H=CODE C$(I)-48: IF H>9 THEN LET H=H-7
45 LET J=CODE C$(I+1)-48: IF J>9 THEN LET J=J-7
46 POKE A,16*H+J: LET A=A+1: NEXT I
47 IF A<=@CODE_LAST@ THEN GO TO 42
50 ON ERR GO TO 500
60 REM T=SECONDS, 0=WAIT KEY; LP=1 REPEATS LIST
70 LET T=10: LET LP=1
72 REM RW=1 RANDOM WIPE; W=0 INSTANT,1 LEFT,2 RIGHT,3 CURTAIN,4 BLINDS
74 LET RW=1: LET W=0: LET WS=2: POKE 39949,WS
80 RESTORE 9500
90 READ P$
100 IF P$="*" THEN GO TO 300
102 LET EC=0
104 IF LEN P$<5 THEN GO TO 110
105 IF P$( TO 4)="ecm:" OR P$( TO 4)="ECM:" THEN LET EC=1: LET P$=P$(5 TO )
110 RANDOMIZE USR 39936
120 LET Q$="tpi:"+P$: LOAD Q$
130 POKE 40960,0
135 IF EC<>0 THEN GO TO 600
140 LOAD "ula-pal" CODE 40960,80
150 LET V=USR 39945
160 IF V<>0 THEN GO TO 500
162 IF PEEK 40966<>0 OR PEEK 40965=7 THEN GO SUB 700
170 LET L=PEEK 40968+256*PEEK 40969
180 LET N=PEEK 40970+256*PEEK 40971
190 LOAD "ula-df1" CODE 41040,L
200 IF N<>0 THEN LOAD "ula-df2" CODE 41040+L,N
205 IF RW<>0 THEN POKE 39948,INT (RND*4)+1
206 IF RW=0 THEN POKE 39948,W
210 LET V=USR 39939
220 IF V<>0 THEN GO TO 500
230 IF T=0 THEN PAUSE 0
240 IF T<>0 THEN PAUSE T*60
250 GO TO 90
300 IF LP<>0 THEN GO TO 80
305 ON ERR RESET
310 RANDOMIZE USR 39942
320 BORDER 7: PAPER 7: INK 0: FLASH 0: BRIGHT 0: INVERSE 0: OVER 0: CLS
330 STOP
500 ON ERR RESET
510 RANDOMIZE USR 39942
520 BORDER 7: PAPER 7: INK 0: FLASH 0: BRIGHT 0: INVERSE 0: OVER 0: CLS
530 PRINT "VIEWER STOPPED"
540 STOP
600 LOAD "ecm-atr" CODE 47184,6144
610 LOAD "ecm-pix" CODE 41040,6144
620 LET V=USR 39954
630 IF V<>0 THEN GO TO 500
640 GO TO 205
@HARDWARE_CHECK@
9000 REM RESIDENT Z80 SUPPORT
@CODE_DATA@
9500 REM EDIT TAP FILENAMES FOR YOUR SD CARD
9510 DATA "ulademo.tap","*"
