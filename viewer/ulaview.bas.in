10 REM ULAVIEW - TS2068 WITH PICOVIDEO
20 CLEAR 39935: BORDER 0: PAPER 0: INK 7: CLS
30 RESTORE 9000
40 LET A=39936
42 READ C$
43 FOR I=1 TO LEN C$ STEP 2
44 LET H=CODE C$(I)-48: IF H>9 THEN LET H=H-7
45 LET J=CODE C$(I+1)-48: IF J>9 THEN LET J=J-7
46 POKE A,16*H+J: LET A=A+1: NEXT I
47 IF A<=@CODE_LAST@ THEN GO TO 42
50 ON ERR GO TO 500
60 REM DISPLAY SECONDS: 0 WAITS FOR A KEY
70 LET T=10
72 REM RW=1 RANDOM WIPE; W=0 INSTANT,1 LEFT,2 RIGHT,3 CURTAIN,4 BLINDS
74 LET RW=1: LET W=0: LET WS=2: POKE 39949,WS
75 LET EC=0
76 REM EC=1 LOADS OLD ECM TAP FILES; EC=0 LOADS ULA FILES
80 PRINT "ULAVIEW: LOAD IMAGE DATA"
90 RANDOMIZE USR 39936
100 POKE 40960,0
105 IF EC<>0 THEN GO TO 600
110 LOAD "ula-pal" CODE 40960,80
120 LET V=USR 39945
130 IF V<>0 THEN GO TO 500
132 IF PEEK 40966<>0 OR PEEK 40965=7 THEN GO SUB 700
140 LET L=PEEK 40968+256*PEEK 40969
150 LET N=PEEK 40970+256*PEEK 40971
160 LOAD "ula-df1" CODE 41040,L
170 IF N<>0 THEN LOAD "ula-df2" CODE 41040+L,N
175 IF RW<>0 THEN POKE 39948,INT (RND*4)+1
176 IF RW=0 THEN POKE 39948,W
180 LET V=USR 39939
190 IF V<>0 THEN GO TO 500
200 IF T=0 THEN PAUSE 0
210 IF T<>0 THEN PAUSE T*60
215 ON ERR RESET
220 RANDOMIZE USR 39942
230 BORDER 7: PAPER 7: INK 0: FLASH 0: BRIGHT 0: INVERSE 0: OVER 0: CLS
240 PRINT "ULAVIEW: RUN FOR ANOTHER IMAGE"
250 STOP
500 ON ERR RESET
510 RANDOMIZE USR 39942
520 BORDER 7: PAPER 7: INK 0: FLASH 0: BRIGHT 0: INVERSE 0: OVER 0: CLS
530 PRINT "VIEWER STOPPED"
540 STOP
600 LOAD "ecm-atr" CODE 47184,6144
610 LOAD "ecm-pix" CODE 41040,6144
620 LET V=USR 39954
630 IF V<>0 THEN GO TO 500
640 GO TO 175
@HARDWARE_CHECK@
9000 REM RESIDENT Z80 SUPPORT
@CODE_DATA@
